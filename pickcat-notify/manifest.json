{
  "manifest_version": 3,
  "name": "pickcat 通知",
  "version": "2.9.0",
  "version_name": "V2.9.0",
  "description": "关掉 Pickcat 网页也能在后台检查未读消息，一条条写清是谁赞了你、回复了哪一楼，点通知直达那一楼；界面与配色对齐 Pickcat 官网，弹窗里能按 @我 / 回复 / 赞 / 关注 / 系统 筛选；设置页能设关注关键词（命中就必弹）并直接查有没有新版。",
  "permissions": ["alarms", "notifications", "storage"],
  "host_permissions": ["https://pickcat.dao3.fun/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "pickcat 通知",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png",
      "192": "icons/icon192.png",
      "256": "icons/icon256.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "192": "icons/icon192.png",
    "256": "icons/icon256.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://pickcat.dao3.fun/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["site-skin.css"],
      "matches": ["https://pickcat.dao3.fun/*"]
    }
  ]
}

